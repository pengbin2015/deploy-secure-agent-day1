# Copy to .env and fill in what your facilitator gives you on the day.
# Kestrel runs with none of this set: the default model is scripted and offline.

# --- your team's model access ------------------------------------------
# Leave KESTREL_LLM=scripted to work offline. Switch to gateway for live chat.
KESTREL_LLM=scripted
KESTREL_LLM_BASE_URL=https://gateway.example.internal/v1
KESTREL_LLM_API_KEY=sk-team-XX-issued-on-the-day
KESTREL_LLM_MODEL=gpt-4o-mini

# --- shared traces (optional) ------------------------------------------
# One Langfuse instance for the room, one project per team.
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- local ---------------------------------------------------------------
KESTREL_TEAM=team-0
KESTREL_DB=./kestrel.db
KESTREL_CONSOLE_PORT=8899

# --- limits you will implement on Day 2 ---------------------------------
KESTREL_MAX_TOOL_CALLS=6
KESTREL_MAX_REFUND_CENTS=20000

# --- facilitator only ----------------------------------------------------
# reference = run the completed controls, for the anchor demos.
# Teams leave this alone.
KESTREL_CONTROLS=student
